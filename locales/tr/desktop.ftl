# The desktop app's own words (apps/desktop): its menu. The hub's page has its own (web.ftl).

desktop-menu-help = Yardım
desktop-menu-safe-mode = Güvenli kipte aç

desktop-notify-finished-named = { $name } işini bitirdi.
desktop-notify-needs-you-named = { $name } sizi bekliyor.
desktop-notify-finished =
    { $count ->
        [one] Bir ajan işini bitirdi.
       *[other] { $count } ajan işini bitirdi.
    }
desktop-notify-needs-you =
    { $count ->
        [one] Bir ajan sizi bekliyor.
       *[other] { $count } ajan sizi bekliyor.
    }
