{
  "agora-theme": 2,
  "name": "Harbour",
  "inherits": "slate",
  "dark": {
    "tokens": { "accent": "#5cc8c2" },
    "regions": { "sidebar": { "surface": "#0b1016" }, "person-entries": { "surface": "#14302f", "line": "#2b6b68" } },
    "terminal": { "background": "#0b1016", "foreground": "#d8e1ea", "red": "#ff7b72" },
    "syntax": { "keyword": "#ff9e8f" }
