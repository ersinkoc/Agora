diff --git a/crates/agora-adapters/tests/rules.rs b/crates/agora-adapters/tests/rules.rs
index c0f3cf1d..e1407a40 100644
--- a/crates/agora-adapters/tests/rules.rs
+++ b/crates/agora-adapters/tests/rules.rs
@@ -314,3 +314,28 @@ contains = " done "
         );
     }
 }
+
+#[test]
+fn a_contains_pattern_with_only_whitespace_stays_literal() {
+    let manifest = Manifest::parse(
+        r#"
+kind = "space"
+display_name = "Space"
+version = "1"
+min_engine = 1
+[process]
+launch = ["fake"]
+[[rules]]
+id = "finished"
+state = "done"
+priority = 1
+region = "title"
+contains = " "
+"#,
+    )
+    .unwrap();
+    let detector = Detector::new(&manifest);
+    let state = |text| detector.detect(&term_with(text)).map(|d| d.state);
+    assert_eq!(state(b"\x1b]0;ready now\x07"), Some(AgentState::Done));
+    assert_eq!(state(b"\x1b]0;ready\x07"), None);
+}
