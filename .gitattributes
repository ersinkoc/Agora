# Fixtures are frozen byte-for-byte contracts (AGENTS.md): never let git rewrite line endings or treat
# binary fixtures as text. Without this, Windows checkouts turn JSON fixtures into CRLF and golden tests fail.
schema/fixtures/**/*.bin binary
schema/fixtures/**/*.json text eol=lf
*.proto text eol=lf
*.ftl text eol=lf
*.py text eol=lf
*.sh text eol=lf
# Captured agent screens are raw terminal bytes (CR included); a Windows checkout with autocrlf would rewrite them.
manifests/agents/fixtures/**/*.screen binary
# Usage and quota fixtures are read line by line and compared with expected text: LF on every platform.
manifests/agents/fixtures/**/*.jsonl text eol=lf
manifests/agents/fixtures/**/*.expect text eol=lf
# The converted ACP registry (ADR-0092) is generated byte for byte and checked byte for byte (icons keep their source's CRLF):
# never let a checkout rewrite its line endings.
manifests/agents/registry/** -text
crates/agora-adapters/tests/fixtures/registry/** -text
# A plugin's files are listed by their SHA-256 in its manifest (ADR-0114): a rewritten line ending would be a wrong hash.
apps/web/plugins/** -text
# `agora manual` prints docs/manual as it is, and its tests read the examples byte for byte (a plugin's hash among them).
docs/manual/*.md text eol=lf
