{
  // Harbour, a VS Code colour theme (a test fixture of Agora's theme import)
  "$schema": "vscode://schemas/color-theme",
  "name": "Harbour",
  "type": "dark",
  "colors": {
    "editor.background": "#0b1016",
    "editor.foreground": "#d8e1ea",
    "sideBar.background": "#10161e",
    "focusBorder": "#5cc8c2",
    "terminalCursor.foreground": "#5cc8c2",
    "terminal.selectionBackground": "#5cc8c240",
    "terminal.ansiBlack": "#1b2430",
    "terminal.ansiRed": "#f2777a",
    "terminal.ansiGreen": "#8fd18a",
    "terminal.ansiYellow": "#e8c46a",
    "terminal.ansiBlue": "#6fb3f2",
    "terminal.ansiMagenta": "#c99cf0",
    "terminal.ansiCyan": "#5cc8c2",
    "terminal.ansiWhite": "#c8d3de",
    "terminal.ansiBrightBlack": "#637387",
    "terminal.ansiBrightRed": "#ff9c9e",
    "terminal.ansiBrightGreen": "#b4ecb0",
    "terminal.ansiBrightYellow": "#f5dc98",
    "terminal.ansiBrightBlue": "#9fd0ff",
    "terminal.ansiBrightMagenta": "#e0c4ff",
    "terminal.ansiBrightCyan": "#93e3de",
    "terminal.ansiBrightWhite": "#f3f7fb",
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7f8c99", "fontStyle": "italic" } },
    { "scope": "keyword, storage.modifier", "settings": { "foreground": "#f2777a" } },
    { "scope": "string.quoted.double", "settings": { "foreground": "#8fd18a" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#e8c46a" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#6fb3f2" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#5cc8c2" } },
    { "name": "no scope", "settings": { "foreground": "#ffffff" } },
  ],
  "semanticHighlighting": true,
}
