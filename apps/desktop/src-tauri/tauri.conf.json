{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agora",
  "version": "0.2.1",
  "identifier": "dev.agora.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Agora", "width": 1200, "height": 800, "minWidth": 480, "minHeight": 480, "create": false }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": false,
    "macOS": { "signingIdentity": "-" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
